<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Remaining Margin Float"
    Width="80"
    Height="80"
    MinWidth="80"
    MaxWidth="400"
    MinHeight="80"
    MaxHeight="560"
    WindowStyle="None"
    ResizeMode="NoResize"
    AllowsTransparency="True"
    Background="Transparent"
    Topmost="True"
    ShowInTaskbar="False"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="FixedC9D2CA" Color="#C9D2CA"/>
        <SolidColorBrush x:Key="FixedE9EEE9" Color="#E9EEE9"/>
        <SolidColorBrush x:Key="Fixed718478" Color="#718478"/>
        <SolidColorBrush x:Key="Fixed46544A" Color="#46544A"/>
        <SolidColorBrush x:Key="FixedE0E3DD" Color="#E0E3DD"/>
        <SolidColorBrush x:Key="FixedF1F3EF" Color="#F1F3EF"/>
        <SolidColorBrush x:Key="Fixed0CFFFFFF" Color="#0CFFFFFF"/>
        <SolidColorBrush x:Key="Fixed244F6B58" Color="#244F6B58"/>
        <SolidColorBrush x:Key="Fixed626965" Color="#626965"/>
        <SolidColorBrush x:Key="Fixed69716C" Color="#69716C"/>
        <SolidColorBrush x:Key="Fixed796B53" Color="#796B53"/>
        <SolidColorBrush x:Key="Fixed96A39A" Color="#96A39A"/>
        <SolidColorBrush x:Key="FixedDCDDD8" Color="#DCDDD8"/>
        <SolidColorBrush x:Key="FixedDCE1DC" Color="#DCE1DC"/>
        <SolidColorBrush x:Key="FixedDCE2DC" Color="#DCE2DC"/>
        <SolidColorBrush x:Key="FixedDDE2DC" Color="#DDE2DC"/>
        <SolidColorBrush x:Key="FixedE0E5DF" Color="#E0E5DF"/>
        <SolidColorBrush x:Key="FixedE1DDD3" Color="#E1DDD3"/>
        <SolidColorBrush x:Key="FixedE5E8E3" Color="#E5E8E3"/>
        <SolidColorBrush x:Key="FixedEEF2ED" Color="#EEF2ED"/>
        <SolidColorBrush x:Key="FixedF02B3831" Color="#F02B3831"/>
        <SolidColorBrush x:Key="FixedF1EFEA" Color="#F1EFEA"/>
        <SolidColorBrush x:Key="FixedF2FFFFFF" Color="#F2FFFFFF"/>
        <SolidColorBrush x:Key="FixedF5F6F2" Color="#F5F6F2"/>
        <SolidColorBrush x:Key="FixedFFFFFF" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#292D2A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#626A65"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8A918C"/>
        <SolidColorBrush x:Key="Sage" Color="#718478"/>
        <SolidColorBrush x:Key="SageSoft" Color="#EEF1ED"/>
        <SolidColorBrush x:Key="StatusStrong" Color="#46564C"/>
        <SolidColorBrush x:Key="StatusBorder" Color="#DCE3DD"/>
        <SolidColorBrush x:Key="Champagne" Color="#8A7658"/>
        <SolidColorBrush x:Key="Surface" Color="#FAFAF7"/>
        <SolidColorBrush x:Key="SurfaceSubtle" Color="#F4F5F1"/>
        <SolidColorBrush x:Key="Border" Color="#E1E3DE"/>
        <SolidColorBrush x:Key="Divider" Color="#E7E8E3"/>

        <Style x:Key="SoftButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="{DynamicResource FixedF1F3EF}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FixedE0E3DD}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource FixedE9EEE9}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource FixedC9D2CA}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Fixed46544A}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Fixed718478}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactHitStyle" TargetType="Border">
            <Setter Property="Background" Value="#01FFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Fixed718478}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MetricTitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LineHeight" Value="13"/>
        </Style>

        <Style x:Key="MetricValueText" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LineHeight" Value="28"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>

        <Style x:Key="MetricHintText" TargetType="TextBlock">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="LineHeight" Value="13"/>
        </Style>

        <Style x:Key="SectionTitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ChartMetaText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="9"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="WindowRoot" Margin="5">
        <Border x:Name="HoverHalo"
                Margin="-1"
                CornerRadius="17"
                BorderThickness="1"
                BorderBrush="{DynamicResource Sage}"
                Background="Transparent"
                Opacity="0"/>

        <Border x:Name="Surface"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="1"
                CornerRadius="16"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect x:Name="SurfaceShadow"
                                  Color="#58635B"
                                  BlurRadius="8"
                                  ShadowDepth="2"
                                  Direction="270"
                                  Opacity="0.07"/>
            </Border.Effect>

            <Grid x:Name="SurfaceLayoutRoot">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="ThemeToolbarRow" Height="0"/>
                    <RowDefinition x:Name="ThemeHeaderRow" Height="69"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid x:Name="ThemeToolbar" Grid.Row="0" Margin="15,8,42,3" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button x:Name="ThemeProviderButton" Style="{StaticResource SoftButton}" Padding="8,0" Height="27" VerticalAlignment="Top" Content="Codex ▾"/>
                    <StackPanel Grid.Column="1" Margin="10,0,6,0">
                        <TextBlock x:Name="ThemeAccountText" FontSize="10" FontFamily="Microsoft YaHei UI" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ThemeAccountHint" FontSize="8.5" FontFamily="Microsoft YaHei UI" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Border Grid.Column="2" Padding="6,3" VerticalAlignment="Top" CornerRadius="4" Background="{DynamicResource FixedF1EFEA}"><TextBlock x:Name="ThemePlanText" FontSize="10" Foreground="{DynamicResource Champagne}"/></Border>
                </Grid>

                <Border x:Name="CompactHit"
                        Grid.Row="1"
                        Style="{StaticResource CompactHitStyle}"
                        Padding="7,5,7,5"
                        Cursor="Hand"
                        ToolTip="拖动移动 · 单击查看详情"
                        Focusable="True">
                    <Grid x:Name="ThemeHeaderContent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition x:Name="CompactProgressRow" Height="12"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="ThemeCompactProvider" Text="Codex" Grid.RowSpan="2" FontSize="8" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI" Foreground="{DynamicResource TextPrimary}" Visibility="Collapsed" IsHitTestVisible="False" VerticalAlignment="Top"/>
                        <TextBlock x:Name="ThemeCompactPeriod" Grid.RowSpan="2" FontSize="8" FontFamily="Microsoft YaHei UI" Foreground="{DynamicResource TextSecondary}" Visibility="Collapsed" IsHitTestVisible="False" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
                        <Grid x:Name="ThemeRing" Grid.RowSpan="2" Width="44" Height="44" Visibility="Collapsed" IsHitTestVisible="False">
                            <Ellipse x:Name="ThemeRingTrack" Margin="3" Stroke="{DynamicResource FixedDCDDD8}" StrokeThickness="3"/>
                            <Path x:Name="ThemeRingArc" Stroke="{DynamicResource Sage}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Viewbox Margin="7" Stretch="Uniform" StretchDirection="DownOnly">
                            <TextBlock x:Name="ThemeRingNumber" Foreground="{DynamicResource StatusStrong}" FontSize="18" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Viewbox>
                        </Grid>
                        <Border x:Name="ThemeRail" Grid.RowSpan="2" Width="5" Height="52" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource FixedDCDDD8}" CornerRadius="2.5" Visibility="Collapsed" IsHitTestVisible="False" ClipToBounds="True">
                            <Border x:Name="ThemeRailFill" VerticalAlignment="Bottom" Background="{DynamicResource Sage}" CornerRadius="2.5" Height="0"/>
                        </Border>
                        <TextBlock x:Name="ThemeHeroLabel" Grid.RowSpan="2" Foreground="{DynamicResource TextPrimary}" FontFamily="Microsoft YaHei UI" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <TextBlock x:Name="ThemeHeroReset" Grid.RowSpan="2" Foreground="{DynamicResource TextSecondary}" FontFamily="Microsoft YaHei UI" FontSize="9.5" VerticalAlignment="Top" TextTrimming="CharacterEllipsis" Visibility="Collapsed" IsHitTestVisible="False"/>

                        <StackPanel x:Name="RemainingSummaryPanel"
                                    Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel x:Name="RemainingNumberPanel"
                                        Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,1,0,0">
                                <TextBlock x:Name="CompactPrefix"
                                           Text=""
                                           Margin="0,0,1,4"
                                           VerticalAlignment="Bottom"
                                           Foreground="{DynamicResource Sage}"
                                           FontFamily="Segoe UI Variable Text"
                                           FontSize="9"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="RemainingValue"
                                           Text="--"
                                           Foreground="{DynamicResource StatusStrong}"
                                           FontFamily="Segoe UI Variable Display"
                                           FontSize="23"
                                           FontWeight="SemiBold"
                                           FontStretch="SemiCondensed"
                                           LineHeight="26"
                                           Typography.NumeralAlignment="Tabular"/>
                                <TextBlock x:Name="CompactSuffix"
                                           Text="%"
                                           Margin="1,0,0,4"
                                           VerticalAlignment="Bottom"
                                           Foreground="{DynamicResource Sage}"
                                           FontFamily="Segoe UI Variable Text"
                                           FontSize="9"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock x:Name="WindowLabel"
                                       Margin="0,0,0,0"
                                       HorizontalAlignment="Center"
                                       Text="Codex 余量"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontFamily="Microsoft YaHei UI"
                                       FontSize="9"/>
                        </StackPanel>

                        <Grid Grid.Row="1" VerticalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ExpandedWindowLabel"
                                       Grid.Column="0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,5"
                                       Visibility="Collapsed"
                                       Text="Codex 余量"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontFamily="Microsoft YaHei UI"
                                       FontSize="8.5"
                                       FontWeight="SemiBold"/>
                            <Grid x:Name="ResetSummaryPanel"
                                  Grid.Column="2"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Bottom"
                                  Margin="0,0,0,5"
                                  Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DetailsResetPrefix"
                                           Grid.Column="0"
                                           Text="下次重置 "
                                           Foreground="{DynamicResource TextMuted}"
                                           FontFamily="Microsoft YaHei UI"
                                           FontSize="12.5"/>
                                <TextBlock x:Name="DetailsResetDate"
                                           Grid.Column="1"
                                           Text="--"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontFamily="Microsoft YaHei UI"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="DetailsResetSeparator"
                                           Grid.Column="2"
                                           Text=" · "
                                           Foreground="{DynamicResource TextMuted}"
                                           FontFamily="Microsoft YaHei UI"
                                           FontSize="12.5"/>
                                <TextBlock x:Name="DetailsResetCountdown"
                                           Grid.Column="3"
                                           Text="--"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontFamily="Microsoft YaHei UI"
                                           FontSize="12.5"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                            </Grid>
                            <Border x:Name="ProgressTrack"
                                    Grid.ColumnSpan="3"
                                    Height="3"
                                    VerticalAlignment="Bottom"
                                    CornerRadius="1.5"
                                    Background="{DynamicResource FixedDCDDD8}"
                                    ClipToBounds="True"
                                    ToolTip="剩余 -- · 已使用 --">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="RemainingProgressColumn" Width="0*"/>
                                        <ColumnDefinition x:Name="UsedProgressColumn" Width="100*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{DynamicResource Sage}"/>
                                    <Border Grid.Column="1" Background="{DynamicResource FixedDCDDD8}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="CompactDivider"
                        Grid.Row="2"
                        Background="{DynamicResource Divider}"
                        Margin="16,0"/>

                <Grid x:Name="DetailsPanel"
                      Grid.Row="3"
                      Margin="20,12,20,12"
                      Visibility="Collapsed"
                      Opacity="0">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="ThemeAccountRow" Height="46"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition x:Name="QuotaMetricRow" Height="132"/>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="52"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="AccountRow" Grid.Row="0" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="AccountName"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="本地 Codex"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontFamily="Microsoft YaHei UI"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                        <Border Grid.Column="1"
                                Margin="9,1,0,0"
                                Padding="7,2"
                                VerticalAlignment="Center"
                                Background="{DynamicResource FixedF1EFEA}"
                                BorderBrush="{DynamicResource FixedE1DDD3}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <TextBlock x:Name="PlanBadge"
                                       Text="Codex"
                                       Foreground="{DynamicResource Fixed796B53}"
                                       FontFamily="Segoe UI Variable Text"
                                       FontSize="9"
                                       FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock x:Name="AccountEmail"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Margin="0,5,0,0"
                                   Text="未找到账号信息"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontFamily="Segoe UI Variable Text"
                                   FontSize="10.5"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                    </Grid>

                    <Border x:Name="ThemeQuotaCard" Grid.Row="2"
                            Background="{DynamicResource SageSoft}"
                            CornerRadius="12"
                            Padding="14,6">
                        <Grid>
                            <Grid x:Name="CodexQuotaPanel" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="FiveHourQuotaRow" Height="*"/>
                                    <RowDefinition x:Name="QuotaDividerRow" Height="5"/>
                                    <RowDefinition x:Name="WeeklyQuotaRow" Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid x:Name="FiveHourQuotaBand" Grid.Row="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="10"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="5 小时"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   FontFamily="Microsoft YaHei UI"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="FiveHourResetText"
                                                   Margin="0,4,8,0"
                                                   Text="等待数据"
                                                   Style="{StaticResource MetricHintText}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="已用" Style="{StaticResource MetricTitleText}"/>
                                        <TextBlock x:Name="FiveHourUsedValue"
                                                   Text="--"
                                                   Style="{StaticResource MetricValueText}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="余额"
                                                   HorizontalAlignment="Right"
                                                   Style="{StaticResource MetricTitleText}"/>
                                        <TextBlock x:Name="FiveHourRemainingValue"
                                                   Text="--"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource StatusStrong}"
                                                   Style="{StaticResource MetricValueText}"/>
                                    </StackPanel>
                                    <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                            Height="3"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource FixedDCE1DC}"
                                            CornerRadius="1.5"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="FiveHourRemainingColumn" Width="0*"/>
                                                <ColumnDefinition x:Name="FiveHourUsedColumn" Width="100*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="ThemeFiveHourFill" Background="{DynamicResource Sage}"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Border x:Name="QuotaDivider"
                                        Grid.Row="1"
                                        Height="1"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource FixedDCE2DC}"/>

                                <Grid x:Name="WeeklyQuotaBand" Grid.Row="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="8"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="每周额度"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontFamily="Microsoft YaHei UI"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="WeeklyResetText"
                                               Grid.Column="1"
                                               Margin="10,0,12,0"
                                               VerticalAlignment="Center"
                                               Text="等待数据"
                                               Style="{StaticResource MetricHintText}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="WeeklyUsedValue"
                                               Visibility="Collapsed"
                                               Text="--"/>
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="WeeklyRemainingValue"
                                                   Text="--"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   FontFamily="Segoe UI Variable Display"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   LineHeight="22"/>
                                        <TextBlock Margin="4,3,0,0"
                                                   Text="剩余"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   FontFamily="Microsoft YaHei UI"
                                                   FontSize="9.5"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <Border x:Name="ThemeWeeklyTrack" Grid.Row="1" Grid.ColumnSpan="3"
                                            Height="3"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource FixedDCE1DC}"
                                            CornerRadius="1.5"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="WeeklyRemainingColumn" Width="0*"/>
                                                <ColumnDefinition x:Name="WeeklyUsedColumn" Width="100*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="ThemeWeeklyFill" Background="{DynamicResource Fixed96A39A}"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>

                            <Grid x:Name="ProviderMetricPanel">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="5"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="MetricOneTitle" Text="今日花费" Style="{StaticResource MetricTitleText}"/>
                                        <TextBlock x:Name="PrimaryMetricValue"
                                                   Text="--"
                                                   Style="{StaticResource MetricValueText}"
                                                   Foreground="{DynamicResource StatusStrong}"/>
                                        <TextBlock x:Name="PrimaryMetricHint"
                                                   Text="等待余额采样"
                                                   Style="{StaticResource MetricHintText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock x:Name="MetricTwoTitle" Text="本月花费" Style="{StaticResource MetricTitleText}"/>
                                        <TextBlock x:Name="TodayTokens" Text="--" Style="{StaticResource MetricValueText}"/>
                                        <TextBlock x:Name="MetricTwoHint"
                                                   Text="等待余额采样"
                                                   Style="{StaticResource MetricHintText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="1"
                                        Height="1"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource FixedE0E5DF}"/>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="MetricThreeTitle" Text="今日输入" Style="{StaticResource MetricTitleText}"/>
                                        <TextBlock x:Name="LastTurnTokens" Text="--" Style="{StaticResource MetricValueText}"/>
                                        <TextBlock x:Name="ContextText"
                                                   Text="所有本机任务"
                                                   Style="{StaticResource MetricHintText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock x:Name="MetricFourTitle" Text="今日输出" Style="{StaticResource MetricTitleText}"/>
                                        <TextBlock x:Name="CacheHit" Text="--" Style="{StaticResource MetricValueText}"/>
                                        <TextBlock x:Name="CacheTokenText"
                                                   Text="所有本机任务"
                                                   Style="{StaticResource MetricHintText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border x:Name="TokenSummaryCard"
                            Grid.Row="3"
                            Margin="0,6,0,0"
                            Background="{DynamicResource FixedF5F6F2}"
                            BorderBrush="{DynamicResource FixedE5E8E3}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="10,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="25"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="ThemeTokenGrid" Grid.ColumnSpan="3" Visibility="Collapsed">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="今日 Token" Foreground="{DynamicResource TextSecondary}" FontFamily="Microsoft YaHei UI" FontSize="9.5"/>
                                    <TextBlock x:Name="ThemeTokenTotal" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI Variable Display" FontSize="21" FontWeight="SemiBold" Margin="0,1,0,0"/>
                                    <TextBlock x:Name="ThemeTokenOutput" Foreground="{DynamicResource TextMuted}" FontFamily="Microsoft YaHei UI" FontSize="9"/>
                                </StackPanel>
                                <Border Grid.Column="1" Width="1" Margin="0,3" Background="{DynamicResource Divider}"/>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="今日缓存" Foreground="{DynamicResource TextSecondary}" FontFamily="Microsoft YaHei UI" FontSize="9.5"/>
                                    <TextBlock x:Name="ThemeTokenCached" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI Variable Display" FontSize="21" FontWeight="SemiBold" Margin="0,1,0,0"/>
                                    <TextBlock x:Name="ThemeTokenHit" Foreground="{DynamicResource TextMuted}" FontFamily="Microsoft YaHei UI" FontSize="9"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="BreakdownTitle" Text="今日缓存" Style="{StaticResource MetricTitleText}"/>
                                <TextBlock x:Name="TokenBreakdown"
                                           Margin="0,4,0,0"
                                           Text="-- cached  ·  命中 --"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontFamily="Microsoft YaHei UI"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            <Border x:Name="TokenSummaryDivider"
                                    Grid.Column="1"
                                    Width="1"
                                    Margin="12,2"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource FixedDDE2DC}"/>
                            <StackPanel Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="SecondaryMetricTitle"
                                           Text="额度状态"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource MetricTitleText}"/>
                                <TextBlock x:Name="ResetCount"
                                           Margin="0,4,0,0"
                                           Text="等待数据"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontFamily="Microsoft YaHei UI"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4" Margin="0,10,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="7"/>
                            <RowDefinition Height="*" MinHeight="87"/>
                            <RowDefinition Height="7"/>
                            <RowDefinition Height="30"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock x:Name="UsageTrendTitle"
                                       Text="使用趋势"
                                       Style="{StaticResource SectionTitleText}"/>
                            <TextBlock x:Name="PredictionText"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       MaxWidth="250"
                                       Text="积累 30 分钟后预测"
                                       Foreground="{DynamicResource StatusStrong}"
                                       FontFamily="Microsoft YaHei UI"
                                       FontSize="9.5"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <TextBlock x:Name="BudgetText"
                                   Grid.Row="1"
                                   Margin="0,4,0,0"
                                   HorizontalAlignment="Right"
                                   FontFamily="Microsoft YaHei UI"
                                   FontSize="9.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource StatusStrong}"
                                   TextTrimming="CharacterEllipsis"/>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="Trend5HCard"
                                    Grid.Column="0"
                                    Background="{DynamicResource SageSoft}"
                                    CornerRadius="9"
                                    Padding="10,7">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="17"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="13"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Text="近 5 小时"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   FontFamily="Microsoft YaHei UI"
                                                   FontSize="9.5"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="Trend5HText"
                                                   HorizontalAlignment="Right"
                                                   Text="积累中"
                                                   Foreground="{DynamicResource StatusStrong}"
                                                   FontFamily="Microsoft YaHei UI"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"/>
                                    </Grid>
                                    <Canvas x:Name="Trend5HCanvas"
                                            Grid.Row="1"
                                            Width="150"
                                            Height="43"
                                            HorizontalAlignment="Center"
                                            ClipToBounds="True">
                                        <Border Width="150" Height="1"
                                                Canvas.Top="21"
                                                Background="{DynamicResource FixedDDE2DC}"/>
                                        <Polygon x:Name="Trend5HArea"
                                                 Fill="{DynamicResource Fixed244F6B58}"/>
                                        <Polyline x:Name="Trend5HLine"
                                                  Stroke="{DynamicResource StatusStrong}"
                                                  StrokeThickness="2"
                                                  StrokeLineJoin="Round"/>
                                        <Ellipse x:Name="Trend5HStartMarker"
                                                 Width="4" Height="4"
                                                 Fill="{DynamicResource FixedFFFFFF}"
                                                 Stroke="{DynamicResource StatusStrong}"
                                                 StrokeThickness="1.5"/>
                                        <Ellipse x:Name="Trend5HEndMarker"
                                                 Width="5" Height="5"
                                                 Fill="{DynamicResource StatusStrong}"/>
                                    </Canvas>
                                    <TextBlock x:Name="Trend5HMetaText"
                                               Grid.Row="2"
                                               Text="等待更多样本"
                                               Style="{StaticResource ChartMetaText}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>

                            <Border x:Name="Trend7Card"
                                    Grid.Column="2"
                                    Background="{DynamicResource SageSoft}"
                                    CornerRadius="9"
                                    Padding="10,7">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="17"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="13"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Text="近 7 日"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   FontFamily="Microsoft YaHei UI"
                                                   FontSize="9.5"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="Trend7Text"
                                                   HorizontalAlignment="Right"
                                                   Text="积累中"
                                                   Foreground="{DynamicResource StatusStrong}"
                                                   FontFamily="Microsoft YaHei UI"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"/>
                                    </Grid>
                                    <Canvas x:Name="Trend7Canvas"
                                            Grid.Row="1"
                                            Width="150"
                                            Height="43"
                                            HorizontalAlignment="Center"
                                            ClipToBounds="True">
                                        <Border Width="150" Height="1"
                                                Canvas.Top="21"
                                                Background="{DynamicResource FixedDDE2DC}"/>
                                        <Polygon x:Name="Trend7Area"
                                                 Fill="{DynamicResource Fixed244F6B58}"/>
                                        <Polyline x:Name="Trend7Line"
                                                  Stroke="{DynamicResource StatusStrong}"
                                                  StrokeThickness="2"
                                                  StrokeLineJoin="Round"/>
                                        <Ellipse x:Name="Trend7StartMarker"
                                                 Width="4" Height="4"
                                                 Fill="{DynamicResource FixedFFFFFF}"
                                                 Stroke="{DynamicResource StatusStrong}"
                                                 StrokeThickness="1.5"/>
                                        <Ellipse x:Name="Trend7EndMarker"
                                                 Width="5" Height="5"
                                                 Fill="{DynamicResource StatusStrong}"/>
                                    </Canvas>
                                    <TextBlock x:Name="Trend7MetaText"
                                               Grid.Row="2"
                                               Text="等待更多样本"
                                               Style="{StaticResource ChartMetaText}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border x:Name="ThemeNotice" Grid.Row="4"
                                Background="{DynamicResource FixedEEF2ED}"
                                CornerRadius="7"
                                Padding="9,5">
                            <Grid>
                                <Ellipse x:Name="RapidDropStatusDot"
                                         Width="6"
                                         Height="6"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource Sage}"/>
                                <TextBlock x:Name="RapidDropText"
                                           Margin="13,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="快速下降监控 · 正在积累样本"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontFamily="Microsoft YaHei UI"
                                           FontSize="9.5"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="38"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SourceText"
                                       Margin="0,0,8,0"
                                       Text="Codex 本地会话快照"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontFamily="Microsoft YaHei UI"
                                       FontSize="9"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="SampleTime"
                                       Grid.Column="1"
                                       Text="采样于 --"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontFamily="Microsoft YaHei UI"
                                       FontSize="9"/>
                        </Grid>
                        <Grid Grid.Row="1">
                            <TextBlock x:Name="FooterStatusText"
                                       VerticalAlignment="Center"
                                       FontSize="9.5"
                                       LineHeight="14"
                                       LineStackingStrategy="BlockLineHeight">
                                <Run x:Name="VersionLabelText"
                                     Text="版本"
                                     Foreground="{DynamicResource TextMuted}"
                                     FontFamily="Microsoft YaHei UI"
                                     BaselineAlignment="Baseline"/><Run Text=" "/><Run x:Name="AppVersionText"
                                     Text="v--"
                                     Foreground="{DynamicResource TextSecondary}"
                                     FontFamily="Segoe UI Variable Text"
                                     FontWeight="SemiBold"
                                     BaselineAlignment="Baseline"/><Run x:Name="VersionSeparatorText"
                                     Text="  ·  "
                                     Foreground="{DynamicResource TextMuted}"
                                     FontFamily="Microsoft YaHei UI"
                                     BaselineAlignment="Baseline"/><Run x:Name="AutoRefreshText"
                                     Text="60 秒后自动刷新"
                                     Foreground="{DynamicResource TextMuted}"
                                     FontFamily="Microsoft YaHei UI"
                                     BaselineAlignment="Baseline"/>
                            </TextBlock>
                            <Button x:Name="RefreshButton"
                                    HorizontalAlignment="Right"
                                    Width="96"
                                    Style="{StaticResource SoftButton}"
                                    Content="立即刷新"
                                    ToolTip="重新读取当前数据源"
                                    AutomationProperties.Name="立即刷新"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- The collapse control lives in the window corner instead of
                     the account row: provider names such as
                     "Kimi Code · <profile>" are long enough to run underneath
                     a right-aligned button. The expanded header keeps its
                     number on the left and its reset line on the bottom row,
                     so the top-right corner stays empty for it. -->
                <Button x:Name="CloseButton"
                        Grid.Row="1"
                        Panel.ZIndex="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,3,6,0"
                        Width="34"
                        Height="34"
                        Style="{StaticResource SoftButton}"
                        Padding="0"
                        Visibility="Collapsed"
                        ToolTip="收起详情"
                        AutomationProperties.Name="收起详情">
                    <TextBlock Text="&#xE70E;"
                               Foreground="{DynamicResource Fixed69716C}"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="11"/>
                </Button>
            </Grid>
        </Border>

        <Grid x:Name="UltraCompactPanel"
              Panel.ZIndex="3"
              Width="14"
              Background="{DynamicResource Fixed0CFFFFFF}"
              HorizontalAlignment="Right"
              VerticalAlignment="Stretch"
              SnapsToDevicePixels="True"
              UseLayoutRounding="True"
              IsHitTestVisible="False"
              Opacity="0">
            <Border x:Name="UltraProgressTrack"
                    Width="12"
                    Margin="0"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    CornerRadius="2"
                    ClipToBounds="True"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True"
                    ToolTip="剩余 --">
                <Grid>
                    <Grid Margin="1">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="UltraEmptyProgressRow" Height="100*"/>
                            <RowDefinition x:Name="UltraRemainingProgressRow" Height="0*"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="UltraProgressFill"
                                Grid.RowSpan="2"
                                Margin="0"
                                CornerRadius="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#25D982" Offset="0"/>
                                    <GradientStop Color="#76D955" Offset="0.42"/>
                                    <GradientStop Color="#FFD447" Offset="0.6"/>
                                    <GradientStop Color="#FF8A3D" Offset="0.8"/>
                                    <GradientStop Color="#F34F60" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="UltraDepletedMask"
                                Grid.Row="0"
                                Background="{DynamicResource Fixed626965}"/>
                        <Border x:Name="UltraLevelMarker"
                                Grid.Row="1"
                                Height="2"
                                VerticalAlignment="Top"
                                Background="{DynamicResource FixedF2FFFFFF}"/>
                    </Grid>
                    <Border x:Name="UltraProgressOutline"
                            Panel.ZIndex="2"
                            Background="Transparent"
                            BorderBrush="{DynamicResource FixedF02B3831}"
                            BorderThickness="1"
                            CornerRadius="2"
                            IsHitTestVisible="False"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
